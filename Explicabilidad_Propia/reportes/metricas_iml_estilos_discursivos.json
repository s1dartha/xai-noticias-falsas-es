 "dimensiones": {
  "D1": {
   "nombre": "Sensacionalismo",
   "rasgo": "sensacionalista",
   "variables": {
    "sens_p_documento": 1,
    "sens_p_media_oraciones": 1,
    "sens_p_max_oraciones": 1
   },
   "justificacion": "Probabilidad de sensacionalismo del documento y de sus oraciones (JJNeila). El tono sensacionalista y la oración gatillo son rasgos recurrentes de la desinformación viral (Horne y Adalı, 2017; Hamby et al., 2023)."
  },
  "D2": {
   "nombre": "Carga emocional",
   "rasgo": "emotivo",
   "variables": {
    "emo_intensidad_media": 1,
    "emo_intensidad_max": 1,
    "emo_ira_media": 1,
    "emo_ira_max": 1,
    "emo_miedo_media": 1,
    "emo_miedo_max": 1,
    "emo_sorpresa_media": 1,
    "emo_sorpresa_max": 1
   },
   "justificacion": "Intensidad emocional (1 − P(sin emoción)) y emociones de alta activación: ira, miedo y sorpresa (RoBERTuito). La desinformación explota emociones negativas de alta activación (Hamby et al., 2023). Tristeza y alegría quedan fuera por ser de baja activación o valencia positiva."
  },
  "D3": {
   "nombre": "Reiteración",
   "rasgo": "reiterativo",
   "variables": {
    "red_sim_max": 1,
    "red_sim_media": 1,
    "red_sim_top3": 1,
    "red_consecutivas_media": 1
   },
   "justificacion": "Similitud semántica entre oraciones (hiiamsid), continua y sin umbrales. La repetición de una misma idea refuerza su credibilidad (efecto de verdad ilusoria; Hasher et al., 1977) y el cuerpo de las noticias falsas es más repetitivo (Horne y Adalı, 2017)."
  },
  "D4": {
   "nombre": "Énfasis ortotipográfico",
   "rasgo": "enfático",
   "variables": {
    "orto_mayusculas_sostenidas": 1,
    "orto_proporcion_mayusculas": 1,
    "orto_exclamaciones": 1,
    "orto_interrogaciones": 1,
    "orto_puntos_suspensivos": 1,
    "orto_comillas": 1
   },
   "justificacion": "Mayúsculas sostenidas, proporción de mayúsculas, exclamaciones, interrogaciones, puntos suspensivos y comillas por palabra. Las noticias falsas usan más mayúsculas y signos de puntuación enfáticos (Horne y Adalı, 2017)."
  },
  "D5": {
   "nombre": "Aserción sin respaldo",
   "rasgo": "asertivo sin fuentes",
   "variables": {
    "ling_intensificadores": 1,
    "ling_pronombres_1p": 1,
    "ling_adjetivos_sustantivos": 1,
    "ling_atenuadores": -1,
    "ling_verbos_dicendi": -1,
    "ling_cifras": -1,
    "ling_referencias_temporales": -1
   },
   "justificacion": "Certeza sin respaldo: más intensificadores, pronombres de primera persona y adjetivación (+), y menos atenuadores, verbos de atribución (dijo, declaró), cifras y referencias temporales (−), que son los anclajes verificables del periodismo informativo (Zhou y Zafarani, 2020)."
  }
 },
